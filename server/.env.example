# Copy to .env. Everything is optional in development.

# Postgres connection string (Neon, Render, Supabase, local…). Leave unset to use an in-memory DB.
DATABASE_URL=
DB_SSL=true

# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=4000
